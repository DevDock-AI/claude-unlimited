# Swift Package Manager build products — regenerated by build.sh, never committed.
.build/
.swiftpm/
*.xcodeproj/

# The bundle build.sh assembles before installing it to ~/Applications.
HUD - Heads-Up Display.app/
# Pre-rename bundle names, kept so older trees stay clean.
CapacityWidget.app/
CapacityDock.app/

# Release artifacts from `build.sh --release`. Only the checksum (HUD.sha256)
# is committed; the zip itself is uploaded to the GitHub release.
dist/
Shaders/
*.metal

# Where build.sh copies those sources for the duration of a build. It deletes
# the directory afterwards; this is what keeps an interrupted build out of git.
Sources/HUD/Generated/
